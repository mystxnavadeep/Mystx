rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Users can read their own profile and Pro status.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can create their initial FREE profile on sign-up, but cannot self-grant Pro.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.isPro == false
        && request.resource.data.plan == 'free'
        && request.resource.data.proExpiresAt == 0;

      // Users can update only name/email; isPro, plan, and proExpiresAt are server/admin-only.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isPro', 'plan', 'proExpiresAt']);

      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.plan in ['monthly', 'yearly']
        && request.resource.data.amountInr in [40, 200];
      allow update, delete: if false;
    }
  }
}
